{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marfa77/passport-photo-specs/schema/specs.schema.json",
  "title": "Passport & visa photo specifications",
  "type": "object",
  "required": ["name", "version", "source_checked", "license", "entries"],
  "properties": {
    "name": {"type": "string"},
    "version": {"type": "string"},
    "source_checked": {"type": "string", "format": "date"},
    "license": {"const": "CC-BY-4.0"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "range": {"type": ["number", "string", "null"], "pattern": "^\\d+(\\.\\d+)?(-\\d+(\\.\\d+)?)?$"},
    "px": {"type": ["string", "null"], "pattern": "^\\d+x\\d+$"},
    "str": {"type": ["string", "null"]},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "country", "iso2", "document", "source_url", "source_checked", "verification"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{2}-[a-z0-9\\-/]+$"},
        "country": {"type": "string"},
        "iso2": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "document": {"type": "string"},
        "width_mm": {"$ref": "#/$defs/range"},
        "height_mm": {"$ref": "#/$defs/range"},
        "width_px": {"type": ["integer", "null"], "minimum": 1},
        "height_px": {"type": ["integer", "null"], "minimum": 1},
        "min_px": {"$ref": "#/$defs/px"},
        "max_px": {"$ref": "#/$defs/px"},
        "dpi": {"type": ["integer", "null"], "minimum": 1},
        "head_height_mm": {"$ref": "#/$defs/range"},
        "head_height_pct": {"$ref": "#/$defs/str"},
        "eye_line": {"$ref": "#/$defs/str"},
        "background": {"$ref": "#/$defs/str"},
        "glasses": {"$ref": "#/$defs/str"},
        "expression": {"$ref": "#/$defs/str"},
        "digital_format": {"$ref": "#/$defs/str"},
        "file_size": {"$ref": "#/$defs/str"},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "source_checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "pixid_guide_url": {"type": ["string", "null"], "pattern": "^https://www\\.pixid\\.studio/"},
        "verification": {"enum": ["official_text_read", "official_search_extract"]},
        "notes": {"$ref": "#/$defs/str"}
      }
    }
  }
}
